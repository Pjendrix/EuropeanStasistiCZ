{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p public/data && cp -r data/. public/data/",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/mep.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>\\d+)"
        }
      ],
      "destination": "/p/:id.html",
      "permanent": true
    }
  ]
}
