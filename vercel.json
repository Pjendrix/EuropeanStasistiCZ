{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p public/data && cp -r data/. public/data/",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "european-stasisticz.vercel.app"
        }
      ],
      "destination": "https://epwatch.cz/:path*",
      "permanent": true
    },
    {
      "source": "/mep.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>\\d+)"
        }
      ],
      "destination": "/p/:id.html",
      "permanent": true
    },
    {
      "source": "/party.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>\\d+)"
        }
      ],
      "destination": "/s/:id.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:dir(p|s|v)/:id(\\d+)",
      "destination": "/:dir/:id.html"
    }
  ]
}
